generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model User {
  id        Int @id@default(autoincrement())
  username  String   @db.VarChar(100)
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
